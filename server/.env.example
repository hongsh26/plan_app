# 서버 환경 변수 예시. 이 파일만 커밋한다.
#
# 실제 값은 `server/.env`에 두고 커밋하지 않는다(.gitignore에 있다).
# 스테이징·프로덕션 자격은 account_backend_design.md §12에 따라 분리하고
# secret manager에서 주입한다. 이 파일의 로컬 값을 재사용하지 않는다.

# ---- 모든 역할 공통 (필수) ----

# local | staging | production
APP_ENV=local

# 런타임 DB 자격. §11의 역할 분리에 따라 api와 worker는 서로 다른 역할을 쓰고,
# 둘 다 DDL 권한이 없다.
#   api       : plantogether_api
#   worker    : plantogether_worker
#   scheduler : plantogether_worker
DATABASE_URL=postgres://plantogether_api:local_api_password@localhost:5432/plantogether?sslmode=disable

# ---- 모든 역할 공통 (선택) ----

# DATABASE_MAX_CONNS=10
# SHUTDOWN_TIMEOUT=15s
# LOG_LEVEL=info

# ---- api 전용 (선택) ----

# HTTP_ADDR=:8080

# ---- api 전용 인증 (필수) ----
#
# APP_ENV가 local이 아니면 api는 기동을 거부한다. Apple refresh token을 KMS로
# 암호화하는 구현이 아직 없기 때문이다(config.ErrKMSNotImplemented).

# access token HMAC 키. base64, 디코딩해서 32바이트 이상.
# 만들기: openssl rand -base64 32
ACCESS_TOKEN_SIGNING_KEY=

# 앱 bundle ID. Apple identity token의 aud와 비교한다.
APPLE_CLIENT_ID=

# Apple refresh token과 APNs push token 로컬 암호화 키. base64, 정확히 32바이트.
# 만들기: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---- api 전용 Apple code 교환 (로컬에서는 선택) ----
#
# 셋 다 있거나 셋 다 없어야 한다. 없으면 code 교환을 건너뛰고 Apple refresh
# token을 저장하지 않는다. 그러면 계정 삭제 때 Apple revoke를 할 수 없다.
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"



# ---- worker / scheduler 전용 (선택) ----

# POLL_INTERVAL=5s

# ---- 개발용 로그인 (시연·로컬 전용) ----

# true이면 identity_token "dev:<이름>"(이름은 [a-z0-9._-] 1~32자)으로 Apple 없이 로그인한다.
# APP_ENV=local에서만 켤 수 있다(다른 환경에서 켜면 기동을 거부한다). 켜면 실제 Apple 로그인은
# 받지 않고 Apple code 교환도 꺼져, 이 모드의 모든 계정이 Apple revoke 대상이 아니다.
# 서버는 127.0.0.1에서만 받도록 시연 스크립트가 기본 설정한다.
# DEV_LOGIN_ENABLED=true

# ---- 요청 제한 (api, docs/rate_limit_design.md) ----

# bucket key_hash의 HMAC 키(base64, 디코딩해 32바이트 이상). APP_ENV=local이면 비워 둘 수
# 있고 고정 기본 키를 쓴다. 그 밖에서는 필수이며 secrets manager에서 주입한다.
# 교체해도 bucket은 최대 1시간만 살아 있어 손실이 없다. 롤링 배포 중에는 옛 키와 새 키가
# 함께 쓰여 실효 한도가 잠시 최대 2배가 될 수 있다.
# RATE_LIMIT_KEY=

# 클라이언트 IP를 읽는 방식: remote_addr 또는 xff. APP_ENV=local의 기본은 remote_addr이고,
# 그 밖에서는 명시 필수다. xff는 X-Forwarded-For의 오른쪽에서 TRUSTED_PROXY_HOPS번째를 쓴다.
# 실제 프록시 수보다 크게 잡으면 위조 우회, 작게 잡으면 프록시 IP로 뭉친다. 배포 시 실제
# 헤더로 검증한다.
# CLIENT_IP_SOURCE=remote_addr
# TRUSTED_PROXY_HOPS=1

# 제한 장치 전용 pool의 최대 연결 수(도메인 pool과 분리)와 서버 측 statement_timeout.
# RATE_LIMIT_POOL_MAX_CONNS=4
# RATE_LIMIT_STATEMENT_TIMEOUT=150ms

# ---- worker 전용 (선택) ----

# job 하나의 점유 기간(17s 이상). worker가 죽으면 이 시간이 지난 뒤 다른 worker가
# 이어받는다. handler 제한 시간은 결과 기록이 lease 안에 끝나도록 이보다 7초 짧다.
# WORKER_LEASE_DURATION=1m
# 한 번에 점유하는 최대 job 수이자 동시 처리 수(1~100).
# WORKER_BATCH_SIZE=10

# ---- 마이그레이션 전용 ----

# DDL 권한이 있는 유일한 역할이다. 런타임 DATABASE_URL과 분리해 두어
# api 자격으로 스키마를 바꾸는 경로를 만들지 않는다 (§11).
#
# 마이그레이션 경로는 위의 APP_ENV도 읽는다. 파괴적 방향(-migrate down, reset)은
# APP_ENV=local에서만 허용되고, 그 밖에서는 DB에 연결하기 전에 거부된다.
MIGRATION_DATABASE_URL=postgres://plantogether_migration:local_migration_password@localhost:5432/plantogether?sslmode=disable

# ---- 통합 테스트 전용 ----

# 설정되지 않으면 PostgreSQL 통합 테스트는 skip된다.
# 스키마를 만들고 지우므로 마이그레이션 자격을 쓴다.
TEST_DATABASE_URL=postgres://plantogether_migration:local_migration_password@localhost:5432/plantogether?sslmode=disable

# DB 역할 분리 테스트용 런타임 역할 자격. 위 URL은 DDL 권한이 있는 migration
# 역할이므로 역할 권한 회귀를 잡으려면 각 역할로 따로 접속해야 한다.
TEST_API_DATABASE_URL=postgres://plantogether_api:local_api_password@localhost:5432/plantogether?sslmode=disable
TEST_WORKER_DATABASE_URL=postgres://plantogether_worker:local_worker_password@localhost:5432/plantogether?sslmode=disable
TEST_READONLY_DATABASE_URL=postgres://plantogether_readonly:local_readonly_password@localhost:5432/plantogether?sslmode=disable

# 1로 두면 통합 테스트가 skip 대신 실패한다. CI에서 켜서 skip이 통과로
# 위장되지 않게 한다.
# REQUIRE_DB_TESTS=1
