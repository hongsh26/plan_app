# 서버 환경 변수 예시. 이 파일만 커밋한다.
#
# 실제 값은 `server/.env`에 두고 커밋하지 않는다(.gitignore에 있다).
# 스테이징·프로덕션 자격은 account_backend_design.md §12에 따라 분리하고
# secret manager에서 주입한다. 이 파일의 로컬 값을 재사용하지 않는다.

# ---- 모든 역할 공통 (필수) ----

# local | staging | production
APP_ENV=local

# 런타임 DB 자격. §11의 역할 분리에 따라 api와 worker는 서로 다른 역할을 쓰고,
# 둘 다 DDL 권한이 없다.
#   api    : plantogether_api
#   worker : plantogether_worker
DATABASE_URL=postgres://plantogether_api:local_api_password@localhost:5432/plantogether?sslmode=disable

# ---- 모든 역할 공통 (선택) ----

# DATABASE_MAX_CONNS=10
# SHUTDOWN_TIMEOUT=15s
# LOG_LEVEL=info

# ---- api 전용 (선택) ----

# HTTP_ADDR=:8080

# ---- worker / scheduler 전용 (선택) ----

# POLL_INTERVAL=5s

# ---- 마이그레이션 전용 ----

# DDL 권한이 있는 유일한 역할이다. 런타임 DATABASE_URL과 분리해 두어
# api 자격으로 스키마를 바꾸는 경로를 만들지 않는다 (§11).
MIGRATION_DATABASE_URL=postgres://plantogether_migration:local_migration_password@localhost:5432/plantogether?sslmode=disable

# ---- 통합 테스트 전용 ----

# 설정되지 않으면 PostgreSQL 통합 테스트는 skip된다.
# 스키마를 만들고 지우므로 마이그레이션 자격을 쓴다.
TEST_DATABASE_URL=postgres://plantogether_migration:local_migration_password@localhost:5432/plantogether?sslmode=disable

# 1로 두면 통합 테스트가 skip 대신 실패한다. CI에서 켜서 skip이 통과로
# 위장되지 않게 한다.
# REQUIRE_DB_TESTS=1
